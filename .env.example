# ==================== ОБЯЗАТЕЛЬНЫЕ ====================

# Токен бота (получить у @BotFather)
BOT_TOKEN=

# Юзернейм бота (без @)
BOT_USERNAME=your_bot_username

# ==================== БАЗА ДАННЫХ ====================

DB_HOST=postgres
DB_PORT=5432
DB_NAME=bot_4_weather_uz
DB_USER=bot_4_weather_uz
DB_PASSWORD=

# ==================== АДМИНЫ ====================

# Telegram ID админов через запятую
ADMIN_IDS=
ADMIN_USERNAME=admin

# ==================== ЛОКАЛИЗАЦИЯ ====================

TIMEZONE=Asia/Tashkent

# ==================== OPENWEATHERMAP API ====================

# Ключ OpenWeatherMap (получить на https://openweathermap.org/api)
OWM_API_KEY=

# Базовые URL OWM (обычно менять не нужно)
OWM_BASE=https://api.openweathermap.org/data/2.5
OWM_GEO_BASE=https://api.openweathermap.org/geo/1.0

# ==================== WEATHERAPI (резервный провайдер) ====================

# Ключ WeatherAPI (получить на https://www.weatherapi.com)
WEATHERAPI_KEY=

# ==================== КЭШ ====================

# TTL кэша текущей погоды (минуты)
CACHE_CURRENT_TTL_MIN=10

# TTL кэша прогноза (минуты)
CACHE_FORECAST_TTL_MIN=60
